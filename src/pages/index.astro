---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { featuredProjects, otherProjects } from '../data/projects';
---

<Base title="Wyatt Lindsey · Projects">
  <section class="intro">
    <h1>Interactive demos, in one place.</h1>
    <p>
      I build things for the browser: 3D, audio, games, and tools. Each demo below runs live from its
      own repository. Launch one here, or open it full screen.
    </p>
  </section>

  <section id="projects" aria-labelledby="projects-heading">
    <h2 id="projects-heading">Projects</h2>
    <div class="grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
      {otherProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</Base>

<style>
  .intro {
    padding: 3rem 0 2rem;
    max-width: 40rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 0.75rem;
  }
  .intro p {
    color: var(--muted);
    font-size: 1.1rem;
    margin: 0;
  }
  h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 1rem;
  }
  .grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 32rem), 1fr));
  }
  .grid > :global(.featured) {
    grid-column: 1 / -1;
  }
</style>
